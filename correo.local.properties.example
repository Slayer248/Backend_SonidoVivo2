# Copia este archivo como correo.local.properties (junto a este, en la carpeta backend-tienda) y completa los datos.
# correo.local.properties está en .gitignore: nunca se sube a GitHub.
# Para Gmail usa una "contraseña de aplicación" (Cuenta de Google > Seguridad > Verificación en 2 pasos > Contraseñas de aplicaciones),
# no la contraseña normal de la cuenta.
spring.mail.username=correo-de-la-tienda@gmail.com
spring.mail.password=contraseña-de-aplicacion-sin-espacios
